<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.mao</groupId>
	<artifactId>mao-app-sso</artifactId>
	<version>1.0.0</version>
	<name>mao-app-sso</name>
	<description>OAuth 2.1 / OpenID Connect 1.0 unified authentication center</description>
	<url>https://github.com/KeepYoungerMao/mao-app-sso</url>
	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<scm>
		<connection>scm:git:https://github.com/KeepYoungerMao/mao-app-sso.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/KeepYoungerMao/mao-app-sso.git</developerConnection>
		<url>https://github.com/KeepYoungerMao/mao-app-sso</url>
	</scm>

	<properties>
		<java.version>25</java.version>
		<!-- MyBatis Starter 不在 Spring Boot BOM 中管理，必须显式声明版本。
		     版本对应关系：Boot 3.2~3.5 → 3.0.x；Boot 4.0 → 4.0.x；Boot 4.1 → 4.1.x -->
		<mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
	</properties>

	<dependencies>
		<!-- Web 层：Spring Boot 4 起 starter-web 更名为 starter-webmvc -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Spring Authorization Server 7.1.1（由 Spring Boot 4.1.1 BOM 管理），
		     同时引入 Boot 侧自动配置 spring-boot-security-oauth2-authorization-server -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-authorization-server</artifactId>
		</dependency>

		<!-- 持久层：MyBatis（替代原 Spring Data JPA）。Starter 会传递引入
		     spring-boot-starter-jdbc（HikariCP + JdbcTemplate），
		     Spring Authorization Server 的 Jdbc* 实现仍然依赖 JdbcTemplate，两者共存。 -->
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
			<version>${mybatis-spring-boot.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- Thymeleaf Spring Security 标签支持（版本 3.1.5.RELEASE，由 BOM 管理） -->
		<dependency>
			<groupId>org.thymeleaf.extras</groupId>
			<artifactId>thymeleaf-extras-springsecurity6</artifactId>
		</dependency>

		<!-- 数据库迁移：Flyway（Boot 4 起自动配置移至 spring-boot-flyway 模块；
		     flyway-mysql 为 MySQL 数据库插件，运行时按 JDBC URL 自动选择） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- MySQL 生产数据库驱动 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- BouncyCastle：Spring Security 7 的 Argon2PasswordEncoder 基于 BC 实现，
             使用 Argon2id 算法必需（Boot BOM 未管理该版本，需显式声明） -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.86</version>
		</dependency>

		<!-- Lombok：仅在编译期生成 getter/setter 等样板代码，provided 不进运行时 jar。
		     版本由 Boot BOM 管理（1.18.48）。
		     注意：项目已显式配置 maven-compiler-plugin 的 annotationProcessorPaths，
		     只声明本依赖而不把 lombok 加进 processorPaths，Lombok 会**静默失效**（不报错、不生成代码）。 -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- ==================== 测试依赖 ==================== -->
		<!-- 说明：已移除 H2 与 Testcontainers，测试直接连接本地 MySQL 测试库
		     （见 IntegrationTestSupport，默认 jdbc:mysql://127.0.0.1:3306/mao_sso_test）。 -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- csrf() / SecurityMockMvcRequestPostProcessors 由现有 MockMvc 流程测试使用，不可移除 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!-- 显式声明 processorPaths 后，javac 只从这里查找注解处理器：
					     JDK 23 起隐式注解处理默认关闭，classpath 上的处理器不会被自动发现。
					     Lombok 必须列在此处，否则完全不生效。 -->
					<annotationProcessorPaths>
						<path>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-configuration-processor</artifactId>
						</path>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<!-- 统一测试时区为 UTC，保证 MySQL 中 Instant 存取语义一致 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>-Duser.timezone=UTC</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
