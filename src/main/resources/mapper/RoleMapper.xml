<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mao.sso.user.mapper.RoleMapper">

    <resultMap id="roleMap" type="com.mao.sso.user.Role">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="roleColumns">
        r.id, r.code, r.name, r.description, r.created_by, r.updated_by, r.created_at, r.updated_at
    </sql>

    <select id="findById" resultMap="roleMap">
        SELECT <include refid="roleColumns"/> FROM roles r WHERE r.id = #{id}
    </select>

    <select id="findByCode" resultMap="roleMap">
        SELECT <include refid="roleColumns"/> FROM roles r WHERE r.code = #{code}
    </select>

    <select id="findAll" resultMap="roleMap">
        SELECT <include refid="roleColumns"/> FROM roles r ORDER BY r.code
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM roles
    </select>

    <insert id="insert" parameterType="com.mao.sso.user.Role"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO roles (code, name, description, created_by, updated_by)
        VALUES (#{code}, #{name}, #{description}, #{createdBy}, #{updatedBy})
    </insert>

</mapper>
